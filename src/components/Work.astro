    title="Loop"
    category="Full-Stack App"
    desc="Task management with real auth — sign in with email or Google, and your tasks follow you across devices via Supabase."
    ghUrl="https://github.com/TavionK/Loop-app"
    demoUrl="https://loop-todo-list.netlify.app/"
  />
</section>
