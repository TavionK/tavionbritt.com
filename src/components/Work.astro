---
import Project from './Project.astro'
import Badge from './Badge.astro'
import { projects } from '../data/projects.ts'
---

<section id="work" class="px-5 py-10 md:px-14 md:py-20">
  <p class="text-muted mb-4 font-mono text-sm tracking-widest uppercase">
    <span class="text-accent">(02)</span> — Selected Work
  </p>
  <h2 class="max-w-[24ch]">Things I've shipped.</h2>
  <div class="border-line my-6 border-t"></div>
  <div>
    {
      projects.map((project) => (
        <Project
          title={project.title}
          category={project.category}
          desc={project.desc}
          ghUrl={project.ghUrl}
          demoUrl={project.demoUrl}
        >
          {project.badges.map((tag) => (
            <Badge text={tag} key={tag} />
          ))}
        </Project>
      ))
    }
  </div>
</section>
