---
import Nav from './Nav.astro'
import logoSmall from '../../assets/logoSmall.svg?raw'
import fullLogo from '../../assets/logoFull.svg?raw'
---

<header
  id="site-header"
  class="border-line bg-surface sticky top-0 z-10 flex items-center justify-between border-b px-5 py-5 transition-transform duration-300 md:px-14 md:py-8"
>
  <a
    href="/"
    aria-label="Tavion Britt logo, go to homepage"
    class="ally-ring text-accent"
  >
    <span class="md:hidden [&>svg]:h-auto [&>svg]:w-8" set:html={logoSmall} />
    <span class="hidden md:block [&>svg]:h-8 [&>svg]:w-auto" set:html={fullLogo} />
  </a>
  <Nav />
</header>

<script>
  const header = document.getElementById('site-header')
  let lastY = window.scrollY

  window.addEventListener('scroll', () => {
    const currentY = window.scrollY
    if (currentY > lastY && currentY > 80) {
      header?.classList.add('-translate-y-full')
    } else {
      header?.classList.remove('-translate-y-full')
    }
    lastY = currentY
  }, { passive: true })
</script>
