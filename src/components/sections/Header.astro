---
import Nav from './Nav.astro'
import logoSmall from '../../assets/logoSmall.svg?raw'
import fullLogo from '../../assets/logoFull.svg?raw'
---

<header
  class="border-line flex items-center justify-between border-b px-5 py-10 md:px-14 md:py-8"
>
  <a
    href="/"
    aria-label="Tavion Britt logo, go to homepage"
    class="ally-ring text-accent"
  >
    <span class="md:hidden [&>svg]:h-auto [&>svg]:w-8" set:html={logoSmall} />
    <span class="hidden md:block [&>svg]:h-8 [&>svg]:w-auto" set:html={fullLogo} />
  </a>
  <Nav />
</header>
