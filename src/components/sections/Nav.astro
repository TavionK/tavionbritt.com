---
import { Menu } from '@lucide/astro'
import { X } from '@lucide/astro'
---

<nav class="font-mono text-sm">
  <ul class="hidden gap-8 md:flex">
    <li>
      <a
        href="#stack"
        class="ally-ring text-muted hover:border-accent cursor-pointer border-b border-transparent tracking-wide duration-250 hover:text-white"
        >Stack</a
      >
    </li>
    <li>
      <a
        href="#work"
        class="ally-ring text-muted hover:border-accent cursor-pointer border-b border-transparent tracking-wide duration-250 hover:text-white"
        >Work</a
      >
    </li>
    <li>
      <a
        href="#contact"
        class="ally-ring bg-accent cursor-pointer rounded-md px-3 py-2 tracking-wide text-black duration-500 hover:brightness-110"
        >Get in touch</a
      >
    </li>
  </ul>

  <!--Mobile button -->
  <button
    aria-label="open main menu"
    aria-expanded="false"
    aria-controls="overlay"
    id="mobile-menu"
    class="ally-ring relative z-1 md:hidden"
    ><Menu id="mobile-menu-open" />
    <X id="mobile-menu-close" class="hidden" /></button
  >

  <!--Mobile menu -->
  <div id="overlay" role="dialog" aria-label="Main navigation" aria-modal="true" class="bg-surface fixed inset-0 hidden md:hidden">
    <ul class="flex h-full flex-col items-center justify-center gap-8">
      <li><a class="ally-ring cursor-pointer" href="#stack">Stack</a></li>
      <li><a class="ally-ring cursor-pointer" href="#work">Work</a></li>
      <li>
        <a
          class="ally-ring bg-accent cursor-pointer rounded-md px-3 py-2 text-black"
          href="#contact">Get in touch</a
        >
      </li>
    </ul>
  </div>
</nav>

<script>
  let isOpen: boolean = false
  const mainFooter: NodeListOf<Element> =
    document.querySelectorAll('main, footer, [href="#main-content"]')
  const mobileMenu: HTMLElement | null = document.getElementById('mobile-menu')
  const mobileMenuClose: HTMLElement | null =
    document.getElementById('mobile-menu-close')
  const mobileMenuOpen: HTMLElement | null =
    document.getElementById('mobile-menu-open')
  const overlay: HTMLElement | null = document.getElementById('overlay')

  mobileMenu?.addEventListener('click', (): void => {
    isOpen ? closeMenu() : openMenu()
  })

  document.querySelectorAll('#overlay a').forEach((link: Element): void => {
    link.addEventListener('click', (): void => {
      closeMenu()
    })
  })

  function openMenu(): void {
    isOpen = true
    overlay?.classList.remove('hidden')
    mobileMenuClose?.classList.remove('hidden')
    mobileMenuOpen?.classList.add('hidden')
    document.body.classList.add('overflow-hidden')
    mobileMenu?.setAttribute('aria-expanded', 'true')
    mobileMenu?.setAttribute('aria-label', 'close main menu')
    mainFooter?.forEach((section) => {
      section.setAttribute('inert', '')
    })
    const firstLink = overlay?.querySelector('a') as HTMLElement | null
    firstLink?.focus()
  }

  function closeMenu(): void {
    isOpen = false
    overlay?.classList.add('hidden')
    mobileMenuClose?.classList.add('hidden')
    mobileMenuOpen?.classList.remove('hidden')
    document.body.classList.remove('overflow-hidden')
    mobileMenu?.setAttribute('aria-expanded', 'false')
    mobileMenu?.setAttribute('aria-label', 'open main menu')
    mainFooter?.forEach((section) => {
      section.removeAttribute('inert')
    })
    mobileMenu?.focus()
  }

  function trapFocus(event: KeyboardEvent): void {
    if (!isOpen) return
    const focusable = [
      mobileMenu,
      ...Array.from(overlay?.querySelectorAll<HTMLElement>('a, button') ?? []),
    ].filter((el): el is HTMLElement => el !== null)
    const first = focusable[0]
    const last = focusable[focusable.length - 1]
    if (event.key === 'Tab') {
      if (event.shiftKey) {
        if (document.activeElement === first) {
          event.preventDefault()
          last.focus()
        }
      } else {
        if (document.activeElement === last) {
          event.preventDefault()
          first.focus()
        }
      }
    }
  }

  document.addEventListener('keydown', (event: KeyboardEvent): void => {
    if (event.key === 'Escape' && isOpen) closeMenu()
    trapFocus(event)
  })
</script>
