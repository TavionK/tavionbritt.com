---
import StackCard from '../ui/StackCard.astro'
import StackCardItem from '../ui/StackCardItem.astro'
---

<section
  class="bg-surface border-line border-t px-5 py-10 md:px-14 md:py-20"
  id="stack"
>
  <p class="text-muted mb-4 font-mono text-sm tracking-widest uppercase">
    <span class="text-accent">(01)</span> — Stack
  </p>
  <h2 class="mb-16 max-w-[24ch]">
    A focused toolkit — the things I reach for daily.
  </h2>
  <div class="grid w-full grid-cols-2 gap-10 md:grid-cols-4">
    <StackCard title="Core">
      <StackCardItem item="HTML" num="01" />
      <StackCardItem item="CSS" num="02" />
      <StackCardItem item="JavaScript" num="03" />
      <StackCardItem item="TypeScript" num="04" />
    </StackCard>
    <StackCard title="Framework">
      <StackCardItem item="React" num="05" />
      <StackCardItem item="Next.js" num="06" />
      <StackCardItem item="Astro" num="07" />
      <StackCardItem item="Tailwind CSS" num="08" />
      <StackCardItem item="Radix" num="09" />
    </StackCard>
    <StackCard title="Platform">
      <StackCardItem item="Supabase" num="10" />
      <StackCardItem item="Git" num="11" />
      <StackCardItem item="Netlify" num="12" />
    </StackCard>
    <StackCard title="Practice">
      <StackCardItem item="Accessibility" num="A11y" />
      <StackCardItem item="Performance" num="Perf" />
    </StackCard>
  </div>
</section>
