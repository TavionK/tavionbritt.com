---
import { MoveUpRight } from '@lucide/astro'
---

<section
  id="contact"
  class="bg-surface border-line border-t px-5 py-10 md:px-14 md:py-20"
>
  <p class="text-muted mb-4 font-mono text-sm tracking-widest uppercase">
    <span class="text-accent">(03)</span> — Contact
  </p>
  <h2 class="mb-4 md:max-w-[24ch]">
    Have something that should feel effortless to use?
  </h2>
  <p class="text-muted mb-8 text-balance md:max-w-[50ch]">
    I'm open to front-end roles and a little select freelance. Fastest way to
    reach me is email — I read every one.
  </p>
  <div class="flex flex-col gap-2">
    <a
      href="mailto:tavion.k.britt99@gmail.com"
      aria-label="email - tavion.k.britt99@gmail.com"
      class="ally-ring border-line flex cursor-pointer items-center justify-between border-y py-6"
    >
      <span class="text-muted font-mono text-xs uppercase md:text-sm"
        >email</span
      >
      <span class="flex items-center gap-2 font-serif md:text-xl"
        >tavion.k.britt99@gmail.com <MoveUpRight
          color="#E89A4C"
          size={15}
          aria-hidden="true"
        /></span
      >
    </a>
    <a
      target="_blank"
      href="https://github.com/TavionK"
      aria-label="github - Tavion K"
      class="ally-ring border-line flex cursor-pointer items-center justify-between border-b py-6"
    >
      <span class="text-muted font-mono text-xs uppercase md:text-sm"
        >github</span
      >
      <span class="flex items-center gap-2 font-serif md:text-xl"
        >github.com/TavionK <MoveUpRight
          color="#E89A4C"
          size={15}
          aria-hidden="true"
        /></span
      >
    </a>
    <a
      target="_blank"
      href="https://www.linkedin.com/in/tavionb/"
      aria-label="linkedin - Tavion B"
      class="ally-ring border-line flex cursor-pointer items-center justify-between border-b py-6"
    >
      <span class="text-muted font-mono text-xs uppercase md:text-sm"
        >linkedin</span
      >
      <span class="flex items-center gap-2 font-serif md:text-xl"
        >in/tavionb <MoveUpRight
          color="#E89A4C"
          size={15}
          aria-hidden="true"
        /></span
      >
    </a>
  </div>
</section>
