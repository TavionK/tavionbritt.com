---
const { title } = Astro.props
const headingId = `stack-card-${title.toLowerCase().replace(/\s+/g, '-')}`
---

<div class="border-accent flex-1 border-t-2 pt-2">
  <h3
    id={headingId}
    class="text-muted mb-2 font-mono text-sm font-medium tracking-widest uppercase"
  >
    {title}
  </h3>
  <ul aria-labelledby={headingId}>
    <slot />
  </ul>
</div>
