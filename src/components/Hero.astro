---
import { ArrowRight } from '@lucide/astro'
---

<section class="px-5 py-10">
  <p class="text-accent mb-4 font-mono text-sm tracking-widest uppercase">
    Frontend Developer - Open to work, 2026
  </p>
  <h1 class="mb-8">
    Frontend developer who builds like <span class="text-accent italic"
      >everyone's</span
    > using your app.
  </h1>
  <p class="text-muted mb-8">
    I'm Tavion Britt. I build fast, accessible interfaces that hold up under
    real conditions — keyboard, screen reader, slow network, and everything in
    between. User-centered isn't a tagline; it's the spec.
  </p>
  <div class="flex flex-col items-start gap-4 md:flex-row md:items-center">
    <a
      href="#work"
      class="bg-accent transition:colors flex items-center gap-2 rounded-md px-4 py-2 font-mono font-bold text-black duration-100 hover:brightness-110"
      >See selected work <ArrowRight size={12} stroke-width={4} />
    </a>
    <a
      href="#contact"
      class="border-line text-muted hover:text-text hover:border-accent transition:colors border-b pb-1 duration-500"
      >Or reach out directly</a
    >
  </div>
</section>
